# ─────────────────────────────────────────────
# FitLog / RunTracker — variables de entorno
# IMPORTANTE: este archivo .env reside SIEMPRE en la raíz del repositorio.
# Copiar a `.env` y ajustar los valores locales (`.env` no se versiona).
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_NAME=FitLog / RunTracker API
ENVIRONMENT=development
DEBUG=true

# ── Seguridad / JWT ──────────────────────────
SECRET_KEY=change-me-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────
# Lista separada por comas (ej: frontend Next.js)
CORS_ORIGINS=http://localhost:3000

# ── Base de datos ────────────────────────────
# Host local para correr la API fuera de Docker.
# Dentro de docker-compose, el servicio `api` sobreescribe DATABASE_URL
# apuntando al host `db` (ver docker-compose.yml).
DATABASE_URL=postgresql+psycopg://fitlog:fitlog@localhost:5432/fitlog
POSTGRES_USER=fitlog
POSTGRES_PASSWORD=fitlog
POSTGRES_DB=fitlog
POSTGRES_PORT=5432

# ── Tests ────────────────────────────────────
# Base separada para la suite de tests (se crea automáticamente si no existe).
TEST_DATABASE_URL=postgresql+psycopg://fitlog:fitlog@localhost:5432/fitlog_test

# ── Bootstrap del primer super_admin (script) ─
SUPER_ADMIN_EMAIL=superadmin@fitlog.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FULL_NAME=Super Admin
