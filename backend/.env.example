# ─────────────────────────────────────────────
# FitLog / RunTracker — variables de entorno
# Fase 0: variables de la aplicación.
# Copiar a `.env` y ajustar los valores locales.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_NAME=FitLog / RunTracker API
ENVIRONMENT=development
DEBUG=true

# ── CORS ─────────────────────────────────────
# Lista separada por comas (ej: frontend Next.js)
CORS_ORIGINS=http://localhost:3000

# ── Base de datos (se agrega en Fase 1) ──────
# DATABASE_URL=postgresql+psycopg://fitlog:fitlog@localhost:5432/fitlog
